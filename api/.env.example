# Copy to .env:  cp .env.example .env

# Main database (matches docker-compose.yml)
DATABASE_URL="postgresql://rewardrail:rewardrail@localhost:5433/rewardrail?schema=public"

# Separate database the e2e tests wipe and rebuild on every run
TEST_DATABASE_URL="postgresql://rewardrail:rewardrail@localhost:5433/rewardrail_test?schema=public"

PORT=3000

# Shared secret between us and the "advertiser" (MMP). Postbacks are signed with
# HMAC-SHA256(rawBody, POSTBACK_SECRET). Use a long random value outside local dev.
POSTBACK_SECRET="dev-only-change-me"

# Where the frontend runs (for CORS)
WEB_ORIGIN="http://localhost:5173"

# Phase 6 (optional). Leave empty and the AI claim feature stays disabled.
LLM_API_KEY=""
